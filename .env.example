# ============================================================================
# JAME Application Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# The .env file is ignored by git and should never be committed.

# Snowflake Cortex LLM Configuration (REQUIRED)
# These credentials are needed for the multi-agent pipeline to access the LLM.

# JWT token for authenticating with Snowflake Cortex API
SNOWFLAKE_API_KEY=your_snowflake_jwt_token_here

# Base URL for Snowflake Cortex API endpoint
# Example: https://your-account.snowflakecomputing.com/api/v2/cortex/v1
SNOWFLAKE_API_BASE=https://your-account.snowflakecomputing.com/api/v2/cortex/v1

# ============================================================================
# Server Configuration (OPTIONAL)
# ============================================================================
# Defaults: localhost (127.0.0.1) on port 8000

# Host address for the FastAPI server
JAME_HOST=127.0.0.1

# Port number for the FastAPI server
JAME_PORT=8000
